# Copia este archivo como ".env" y cambia los valores.
# Puerto del servidor
PORT=3000

# "production" activa cookies Secure + HSTS (requiere HTTPS)
NODE_ENV=development

# Clave para firmar los JWT. Usa una cadena larga y aleatoria (mínimo 32 caracteres).
# Puedes generar una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_muy_larga_y_aleatoria_de_al_menos_32_caracteres

# Cuenta de administrador que se crea la primera vez que arranca el sistema
ADMIN_NOMBRE=Administrador FULL SOCCER
ADMIN_EMAIL=admin@fullsoccer.ec
ADMIN_PASSWORD=Admin#Pinsha2026

# true si la app corre detrás de un proxy/hosting (Render lo detecta solo)
TRUST_PROXY=false

# Cargar datos de ejemplo (equipos, partidos, goles) en el primer arranque: true / false
SEED_DEMO=true
